# ── Engine ────────────────────────────────────────────────────────────────
# DRY_RUN (default, writes .eml files to /outbox, sends NOTHING)
# SANDBOX  (sends real email but ONLY to SANDBOX_RECIPIENT)
# LIVE     (real sending; also requires one-time /golive confirmation in Telegram)
ENGINE_MODE=DRY_RUN
DATABASE_URL=sqlite:///data/growth.db
LOG_LEVEL=INFO

# ── LLM ───────────────────────────────────────────────────────────────────
# Local Ollama is the zero-config default. API providers (OpenAI, Anthropic,
# OpenRouter, Groq, any OpenAI-compatible server) are added from the dashboard:
# Admin > Models. Role assignments made there override the env models below.
OLLAMA_BASE_URL=http://localhost:11434
# Cost guard: max calls per API provider per day, then automatic fallback to
# local Ollama for the rest of the day. Local models are never capped.
API_DAILY_CALL_CAP=300
# Quality tasks (email drafting). A 7B Q4 model fits fully on an 8GB GPU.
WRITER_MODEL=qwen2.5:7b-instruct
# Tip: on 8GB VRAM keep writer and classifier the SAME model. Two different 7-8B
# models cause constant VRAM swap thrash; one resident model does both jobs fast.
CLASSIFIER_MODEL=qwen2.5:7b-instruct
# Optional override for the researcher; empty = use CLASSIFIER_MODEL
RESEARCHER_MODEL=

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot). Only this id may command the bot.
TELEGRAM_USER_ID=0

# ── SMTP / IMAP (Zoho or Gmail app password) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Your Name
FROM_EMAIL=
IMAP_HOST=
# IMAP user/password default to the SMTP ones when left empty
IMAP_USER=
IMAP_PASSWORD=
# Where SANDBOX mode delivers everything (your own inbox)
SANDBOX_RECIPIENT=

# ── Sending rails (hard maxima are enforced in code and cannot be raised) ─
# Warm-up ramp is hard-coded: day 1-7 max 10/day, day 8-14 max 20/day, then 30/day.
# This value can only LOWER the cap, never raise it above the warm-up schedule.
DAILY_SEND_CAP=30
SEND_WINDOW_START=09:00
SEND_WINDOW_END=16:30
SEND_TIMEZONE=America/New_York
JITTER_MIN_MINUTES=3
JITTER_MAX_MINUTES=12
BOUNCE_BREAKER_RATE=0.03
BOUNCE_BREAKER_WINDOW=50

# ── CAN-SPAM footer ───────────────────────────────────────────────────────
UNSUBSCRIBE_LINE=Reply STOP or unsubscribe to never hear from me again.
POSTAL_ADDRESS=Example Co | your postal address here

# ── Prospector ────────────────────────────────────────────────────────────
# Providers: registry (US license registries, default) · osm (OpenStreetMap,
# free, keyless, worldwide — any niche, any country) · places (Google Places
# API, requires key, costs money) · csv (import) · gosom (see README)
# Google Places (optional): create a key in Google Cloud Console and CONFIRM
# current pricing/free allowance there before enabling. The daily cap stops
# calls once reached — it never silently continues spending.
PLACES_API_KEY=
PLACES_DAILY_CALL_CAP=200
# registry = state contractor license registries (FL live; public records, zero risk)
# gosom    = google-maps-scraper binary in bin/ (needs US egress, see README)
# csv      = import a CSV file
PROSPECT_PROVIDER=registry
REGISTRY_DEFAULT_STATE=FL
# Find each licensed business's website via DuckDuckGo (needed for the email path)
REGISTRY_DISCOVER_WEBSITES=true
GOSOM_BINARY=bin/google-maps-scraper.exe
GOSOM_DEPTH=5
GOSOM_TIMEOUT_SECONDS=900
GOSOM_EXTRA_ARGS=
MIN_REVIEW_COUNT=10
MAX_REVIEW_COUNT=200
FRANCHISE_KEYWORDS=one hour heating,benjamin franklin plumbing,mr rooter,roto-rooter,mister sparky,aire serv,mr. electric,mr. handyman,ars rescue,service experts,horizon services,abc home,john moore,tradesmen international

# ── Campaign (bootstrap fallback; the real campaign lives in Admin > Campaign)
# WHO is sending and WHAT you sell. These example values keep DRY_RUN working
# out of the box; the dashboard shows a banner until you configure your own.
COMPANY_NAME=Example Co
PRODUCT_PITCH=an AI front desk that instantly texts back every missed call, answers the customer's questions, and books the job onto your calendar
TARGET_NICHE=US home-service businesses
SENDER_ROLE=founder
COMPANY_WEBSITE=https://example.com
DEMO_URL=https://example.com/demo
CALENDLY_URL=https://example.com/call
DEFAULT_JOB_VALUE=400
# Per-trade average job values (trade:dollars, comma separated)
JOB_VALUE_BY_TRADE=plumbing:500,plumber:500,hvac:700,electrician:450,electrical:450
MISSED_CALLS_PER_WEEK=5

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=changeme

# ── Phone access (free Cloudflare Quick Tunnel, no account needed) ─────────
# true = print a public https://<random>.trycloudflare.com link at startup so
# you can open the dashboard from your phone. Requires bin/cloudflared.exe
# (https://github.com/cloudflare/cloudflared/releases/latest).
# Refuses to start while DASHBOARD_PASSWORD is still "changeme": the URL is
# public and the password is the only thing protecting it.
TUNNEL_ENABLED=false
# Optional explicit path; blank = bin/cloudflared.exe or one found on PATH
CLOUDFLARED_BINARY=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
SECRET_KEY=change-this-to-a-long-random-string

# ── Reporter ──────────────────────────────────────────────────────────────
REPORT_TIME=20:00
REPORT_TIMEZONE=UTC

# ── Researcher ────────────────────────────────────────────────────────────
# local = summarize the enricher's scraped site text (default)
# web   = real web research per prospect (ddgs searches + page fetches)
RESEARCH_MODE=local
RESEARCH_MAX_PAGES=3
# Optional: use a self-hosted SearXNG instead of ddgs (e.g. http://localhost:8888)
SEARXNG_BASE_URL=

# ── Reply watcher / verifier ──────────────────────────────────────────────
REPLY_POLL_MINUTES=3
SMTP_PROBE_ENABLED=true
# Set to YOUR sending domain: some MX hosts judge SMTP probes by them
VERIFIER_HELO_DOMAIN=yourdomain.com
VERIFIER_PROBE_FROM=verify@yourdomain.com
# true = forbid ALL hyphens in drafts (even "60-second"); false = forbid only
# em/en dashes and spaced " - " punctuation dashes
STRICT_NO_HYPHENS=false
